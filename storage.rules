rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email == 'admin@connectclubvce.in' && request.auth.token.email_verified == true) ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'superadmin'
      );
    }

    function isStaff() {
      return isAdmin() || (request.auth != null && request.auth.token.role == 'member');
    }

    function isAllowedAsset() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        (
          request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)') ||
          request.resource.contentType.matches('video/(mp4|webm|ogg|quicktime)')
        );
    }

    // Public media buckets remain readable if legacy URLs exist; writes require staff + strict MIME/size checks (no SVG/HTML).
    match /events/{allPaths=**} {
      allow read: if true;
      allow create, update: if isStaff() && isAllowedAsset();
      allow delete: if isAdmin();
    }

    match /gallery/{allPaths=**} {
      allow read: if true;
      allow create, update: if isStaff() && isAllowedAsset();
      allow delete: if isAdmin();
    }

    match /projects/{allPaths=**} {
      allow read: if true;
      allow create, update: if isStaff() && isAllowedAsset();
      allow delete: if isAdmin();
    }

    // Default deny all other paths.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
