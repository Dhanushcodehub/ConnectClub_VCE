# Copy this file to `.env.local` and fill in real values.
# Every Firebase Admin endpoint (club chat, certificates, member list,
# attendance, account deletion, registration approval) fails with
# "Firebase Admin environment variables are missing" until the
# FIREBASE_* block below is set.

# ---------------------------------------------------------------------------
# Firebase web SDK (public) - src/lib/firebase/firebase.ts
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin SDK (server only) - src/lib/firebase/admin.ts
# Service account: Firebase console > Project settings > Service accounts >
# "Generate new private key". Keep the whole value, including BEGIN/END lines.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Optional: mirrored InspireX Firebase project used by the attendance sync.
# Attendance still saves locally when these are absent; only the external
# mirror is skipped.
# ---------------------------------------------------------------------------
INSPIREX_FIREBASE_PROJECT_ID=
INSPIREX_FIREBASE_CLIENT_EMAIL=
INSPIREX_FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Optional integrations - pages degrade gracefully when these are absent.
# ---------------------------------------------------------------------------
# Cloudinary (project/image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini / Groq (AI assist)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_MOCK_MODE=
AI_MOCK_MODE=
AI_FORCE_FAILOVER=
AI_CACHE_TTL_MS=
GROQ_API_KEY=
GROQ_MODEL=

# Email delivery (password resets, notifications)
EMAIL_USER=
EMAIL_APP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=

# Signature on the external registration webhook body
CONNECT_CLUB_WEBHOOK_SECRET=
