rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read events and projects
    match /events/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /projects/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
