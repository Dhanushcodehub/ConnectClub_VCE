rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin@connectclubvce.in' || 
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Anyone can read events and projects
    match /events/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projects/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /user_projects/{document=**} {
      allow read: if true;
      allow write: if request.auth != null; // logged in users can submit
    }
    match /timeline/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gallery_media/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Admins can read their own admin document; only Server Admin SDK can write admins
    match /admins/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // Allow logging login history
    match /loginHistory/{document=**} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    // Allow users to read/write their own profile, admins can read all
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /event_registrations/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    match /certificates/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    match /notifications/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    // Chats and messaging
    match /messages/{document=**} {
      allow read, write: if request.auth != null; // Everyone can use general club chat
    }
    match /direct_messages/{document=**} {
      allow read, write: if request.auth != null && (
        resource == null ||
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        request.resource.data.senderId == request.auth.uid ||
        isAdmin()
      );
    }
    match /typing_status/{document=**} {
      allow read, write: if request.auth != null; 
    }
    match /unreadCounts/{document=**} {
      allow read, write: if request.auth != null; 
    }
    match /typingStatus/{document=**} {
      allow read, write: if request.auth != null; 
    }
    match /forms/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /members/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /registrations/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── External Registration Inbox ───────────────────────────────────────
    // Written to by external sites (InspireX etc.) using Connect Club's
    // public client SDK. No auth needed to create — Firestore Rules validate
    // the required fields. Immutable once written (no update/delete).
    // Only admins can read and approve.
    match /external_registrations/{docId} {
      // Anyone (external site) can create — but fields are validated
      allow create: if
        request.resource.data.keys().hasAll(['eventId', 'rollNo', 'name', 'email', 'registeredAt']) &&
        request.resource.data.eventId == 'inspirex-s2' &&
        request.resource.data.rollNo is string &&
        request.resource.data.rollNo.size() >= 4 &&
        request.resource.data.rollNo.size() <= 30 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 3 &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.registeredAt is timestamp;

      // Nobody can update or delete via client SDK — only Admin SDK can
      allow update, delete: if false;

      // Only admins can read
      allow read: if isAdmin();
    }
    
    // ── Contact Messages Inbox ──────────────────────────────────────────
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // Everything else, admins can do anything
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
