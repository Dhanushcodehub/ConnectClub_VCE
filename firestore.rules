rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'admin@connectclubvce.in' && request.auth.token.email_verified == true) ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'superadmin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isMember() {
      return isSignedIn() && request.auth.token.role == 'member';
    }

    // Staff = club members + admins.
    function isStaff() {
      return isAdmin() || isMember();
    }

    function isSafeUrlOrEmpty(val) {
      return !(val is string) ||
        val == '' ||
        val.matches('^https://.*') ||
        val.matches('^http://.*') ||
        val.matches('^/[^/].*');
    }

    function isValidLikeCounterDelta() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentsCount']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes']) ||
          (
            request.resource.data.likes is int &&
            resource.data.get('likes', 0) is int &&
            request.resource.data.likes >= 0 &&
            (
              request.resource.data.likes == resource.data.get('likes', 0) + 1 ||
              request.resource.data.likes == resource.data.get('likes', 0) - 1
            )
          )
        ) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentsCount']) ||
          (
            request.resource.data.commentsCount is int &&
            resource.data.get('commentsCount', 0) is int &&
            request.resource.data.commentsCount == resource.data.get('commentsCount', 0) + 1
          )
        );
    }

    // Public catalog collections (staff write)
    match /events/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isStaff();
      allow update: if isSignedIn() && isValidLikeCounterDelta();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() &&
          request.resource.data.get('authorId', null) == request.auth.uid &&
          request.resource.data.get('content', '') is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 2000;
        allow update, delete: if isAdmin() ||
          (isSignedIn() && resource.data.get('authorId', null) == request.auth.uid);
      }
    }

    match /user_projects/{projectId} {
      allow read: if resource.data.get('status', 'approved') == 'approved' ||
        isAdmin() ||
        (isSignedIn() && resource.data.get('userId', null) == request.auth.uid);

      // Owners submit their own project strictly as pending with zeroed counters.
      allow create: if isSignedIn() &&
        request.resource.data.get('userId', null) == request.auth.uid &&
        request.resource.data.get('status', 'pending') == 'pending' &&
        request.resource.data.get('likes', 0) == 0 &&
        request.resource.data.get('commentsCount', 0) == 0 &&
        isSafeUrlOrEmpty(request.resource.data.get('githubUrl', '')) &&
        isSafeUrlOrEmpty(request.resource.data.get('demoUrl', ''));

      // Owners may edit content fields only (never status, userId, likes, commentsCount).
      allow update: if isAdmin() ||
        (
          isSignedIn() &&
          resource.data.get('userId', null) == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'status', 'likes', 'commentsCount', 'createdAt']) &&
          isSafeUrlOrEmpty(request.resource.data.get('githubUrl', '')) &&
          isSafeUrlOrEmpty(request.resource.data.get('demoUrl', ''))
        ) ||
        (isSignedIn() && isValidLikeCounterDelta());

      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.get('userId', null) == request.auth.uid);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() &&
          request.resource.data.get('authorId', null) == request.auth.uid &&
          request.resource.data.get('content', '') is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 2000;
        allow update, delete: if isAdmin() ||
          (isSignedIn() && resource.data.get('authorId', null) == request.auth.uid);
      }
    }

    match /timeline/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /gallery_media/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Certificate templates (staff-only).
    match /event_templates/{eventId} {
      allow read, write: if isStaff();
    }

    // Audit trail & internal secrets / rate limits: Admin SDK only.
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /admin_secrets/{userId} {
      allow read, write: if false;
    }
    match /_rate_limits/{bucketId} {
      allow read, write: if false;
    }

    // Admin metadata readable by owner/admins; written only via Admin SDK.
    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // Login history
    match /loginHistory/{document=**} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // User profiles: owners cannot escalate privileges (`role`, `isAdmin`, `permissions`)
    // or forge server-owned counters/identity fields.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.get('uid', userId) == userId &&
        !request.resource.data.keys().hasAny(['role', 'isAdmin', 'permissions']) &&
        request.resource.data.get('projectsCount', 0) == 0 &&
        request.resource.data.get('likesReceived', 0) == 0 &&
        request.resource.data.get('commentsCount', 0) == 0 &&
        request.resource.data.get('certificatesCount', 0) == 0 &&
        isSafeUrlOrEmpty(request.resource.data.get('linkedinUrl', '')) &&
        isSafeUrlOrEmpty(request.resource.data.get('githubUrl', ''))
      );

      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isAdmin', 'permissions', 'uid', 'email', 'provider',
          'projectsCount', 'likesReceived', 'commentsCount', 'certificatesCount', 'createdAt'
        ]) &&
        isSafeUrlOrEmpty(request.resource.data.get('linkedinUrl', '')) &&
        isSafeUrlOrEmpty(request.resource.data.get('githubUrl', ''))
      );

      allow delete: if isAdmin();
    }

    // Registrations & certificates: client writes blocked (issued via Admin SDK only).
    match /event_registrations/{docId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /certificates/{docId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /notifications/{docId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read is bool
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Staff-only club chat
    match /messages/{docId} {
      allow read: if isStaff();
      allow create: if isStaff() &&
        request.resource.data.get('senderEmail', '') == request.auth.token.email &&
        request.resource.data.get('text', '') is string &&
        request.resource.data.text.size() <= 4000;
      allow update: if isAdmin() || (
        isStaff() && (
          resource.data.get('senderEmail', '') == request.auth.token.email ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        )
      );
      allow delete: if isAdmin() ||
        (isStaff() && resource.data.get('senderEmail', '') == request.auth.token.email);
    }

    match /direct_messages/{document=**} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.roomId == request.auth.token.email ||
        resource.data.senderEmail == request.auth.token.email
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          request.resource.data.roomId == request.auth.token.email &&
          request.resource.data.senderEmail == request.auth.token.email &&
          request.resource.data.get('senderRole', 'member') != 'admin'
        )
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.senderEmail == request.auth.token.email ||
        (
          resource.data.roomId == request.auth.token.email &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        )
      );
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.senderEmail == request.auth.token.email);
    }

    match /typing_status/{document=**} {
      allow read, write: if isStaff();
    }
    match /unreadCounts/{document=**} {
      allow read, write: if isStaff();
    }
    match /typingStatus/{document=**} {
      allow read, write: if isStaff();
    }

    match /forms/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /members/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /registrations/{document=**} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // External Registration Inbox (immutable after validated creation)
    match /external_registrations/{docId} {
      allow create: if
        request.resource.data.keys().hasAll(['eventId', 'rollNo', 'name', 'email', 'registeredAt']) &&
        request.resource.data.eventId == 'inspirex-s2' &&
        request.resource.data.rollNo is string &&
        request.resource.data.rollNo.size() >= 4 &&
        request.resource.data.rollNo.size() <= 30 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 3 &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.registeredAt is timestamp;
      allow update, delete: if false;
      allow read: if isAdmin();
    }

    // Contact messages must go through rate-limited /api/contact (Admin SDK).
    match /contact_messages/{messageId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /contactInquiries/{entryId} {
      allow create: if
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 3 &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 2 &&
        request.resource.data.message.size() <= 3000;
      allow read, update, delete: if isAdmin();
    }

    // Feedback forms & responses
    match /feedback_forms/{formId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responsesCount']) &&
        request.resource.data.responsesCount is int &&
        resource.data.get('responsesCount', 0) is int &&
        request.resource.data.responsesCount == resource.data.get('responsesCount', 0) + 1;
    }

    match /feedback_responses/{responseId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.get('userId', null) == request.auth.uid);
      allow create: if request.resource.data.get('userId', null) == null ||
        (isSignedIn() && request.resource.data.get('userId', null) == request.auth.uid);
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.get('userId', null) == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Default deny for everything else unless admin
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
